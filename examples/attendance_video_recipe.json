        "expression": "2"
      }
    },
    "outputs": {
      "variable": "output_row"
    }
  },
  {
    "prototype_name": "workflow.forin",
    "inputs": {
      "list": {
        "variable": "excel_data"
      },
      "loop_start_index": "0",
      "loop_end_index": "-1",
      "output_with_index": {
        "expression": "False"
      }
    },
    "outputs": {
      "loop_item": "loop_item"
    }
  },
  {
    "prototype_name": "workflow.if",
    "inputs": {
      "operand1": {
        "expression": "float(loop_item[3])"
      },
      "operator": ">",
      "operand2": {
        "expression": "0"
      },
      "operator_options": "{}"
    },
    "outputs": {}
  },
  {
    "prototype_name": "excel.write_data_to_workbook",
    "inputs": {
      "workbook": {
        "variable": "excel_instance2"
      },
      "write_range": "area",
      "write_way": "append",
      "write_column_way": "override",
      "content": {
        "expression": "[loop_item]"
      },
      "row_num": {
        "expression": "output_row"
      },
      "column_name": "A",
      "begin_row_num": "1"
    },
    "outputs": {}
  },
  {
    "prototype_name": "programing.variable",
    "inputs": {
      "value_type": "int",
      "value": {
        "expression": "output_row + 1"
      }
    },
    "outputs": {
      "variable": "output_row"
    }
  },
  {
    "prototype_name": "workflow.endif",
