        "variable": "excel_instance2"
      },
      "write_range": "area",
      "write_way": "append",
      "write_column_way": "override",
      "content": {
        "expression": "[['学院', '班级', '姓名', '缺勤学时']]"
      },
      "row_num": {
        "expression": "1"
      },
      "column_name": "A",
      "begin_row_num": "1"
    },
    "outputs": {}
  },
  {
    "prototype_name": "programing.variable",
    "inputs": {
